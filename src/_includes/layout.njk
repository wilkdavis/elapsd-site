<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ title or "Elapsd" }}</title>
  <meta name="description" content="{{ description or 'A calm, simple time tracker for real life.' }}" />

  <!-- Open Graph (optional but nice for sharing) -->
  <meta property="og:title" content="{{ title or 'Elapsd' }}" />
  <meta property="og:description" content="{{ description or 'A calm, simple time tracker for real life.' }}" />
  <meta property="og:type" content="website" />

  <link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body>
  {% include "nav.njk" %}

  <main class="container">
    <article class="card">
      {{ content | safe }}
    </article>
  </main>

  <div class="lightbox" id="lightbox" hidden>
    <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Expanded screenshot viewer">
      <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Close screenshot viewer">Close</button>
      <button class="lightbox-nav lightbox-prev" id="lightbox-prev" type="button" aria-label="Previous screenshot">Previous</button>
      <img class="lightbox-image" id="lightbox-image" src="" alt="" />
      <button class="lightbox-nav lightbox-next" id="lightbox-next" type="button" aria-label="Next screenshot">Next</button>
    </div>
  </div>

  {% include "footer.njk" %}
  <script type="module" src="/assets/js/lightbox.js"></script>
</body>
</html>
